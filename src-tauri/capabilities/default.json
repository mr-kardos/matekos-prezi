{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Open/save presentations and exported PowerPoint/PDF files anywhere the user chooses",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "opener:default"
  ]
}